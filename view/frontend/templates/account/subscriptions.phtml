$items = $block->getSubscriptions();
?>
<div class="byte8-stock-radar-account">
    <h1 class="text-2xl font-semibold mb-6"><?= $escaper->escapeHtml(__('My Stock Notifications')) ?></h1>

    <?php if ($items === []): ?>
        <div class="rounded-md bg-gray-50 border border-gray-200 px-4 py-3 text-gray-700">
            <?= $escaper->escapeHtml(__("You don't have any active stock notifications. Visit a product page that's out of stock to subscribe.")) ?>
        </div>
    <?php else: ?>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                <tr class="border-b border-gray-200 bg-gray-50">
                    <th class="px-3 py-2 text-sm font-medium"><?= $escaper->escapeHtml(__('Product')) ?></th>
                    <th class="px-3 py-2 text-sm font-medium"><?= $escaper->escapeHtml(__('SKU')) ?></th>
                    <th class="px-3 py-2 text-sm font-medium"><?= $escaper->escapeHtml(__('Status')) ?></th>
                    <th class="px-3 py-2 text-sm font-medium"><?= $escaper->escapeHtml(__('Subscribed')) ?></th>
                    <th class="px-3 py-2 text-sm font-medium text-right"><?= $escaper->escapeHtml(__('Actions')) ?></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($items as $item): ?>
                    <tr class="border-b border-gray-100 hover:bg-gray-50">
                        <td class="px-3 py-3 align-top">
                            <?php if ($item['product_url']): ?>
                                <a href="<?= $escaper->escapeUrl($item['product_url']) ?>"
                                   class="text-primary hover:underline">
                                    <?= $escaper->escapeHtml($item['product_name']) ?>
                                </a>
                            <?php else: ?>
                                <span class="text-gray-500 italic"><?= $escaper->escapeHtml($item['product_name']) ?></span>
                            <?php endif; ?>
                        </td>
                        <td class="px-3 py-3 align-top text-sm text-gray-600"><?= $escaper->escapeHtml($item['sku']) ?></td>
                        <td class="px-3 py-3 align-top">
                            <?php $status = $item['status']; ?>
                            <span class="inline-block px-2 py-1 text-xs rounded-md
                                <?= $status === 'pending' ? 'bg-amber-100 text-amber-800' : '' ?>
                                <?= $status === 'notified' ? 'bg-green-100 text-green-800' : '' ?>
                                <?= $status === 'cancelled' ? 'bg-gray-100 text-gray-700' : '' ?>
                                <?= $status === 'bounced' ? 'bg-red-100 text-red-800' : '' ?>
                            ">
                                <?= $escaper->escapeHtml($block->getStatusLabel($status)) ?>
                            </span>
                        </td>
                        <td class="px-3 py-3 align-top text-sm text-gray-600">
                            <?= $escaper->escapeHtml($item['created_at']) ?>
                        </td>
                        <td class="px-3 py-3 align-top text-right">
                            <a href="<?= $escaper->escapeUrl($block->getCancelUrl($item['unsubscribe_token'])) ?>"
                               class="text-sm text-red-600 hover:underline"
                               onclick="return confirm('<?= $escaper->escapeJs(__('Cancel this notification?')) ?>')">
                                <?= $escaper->escapeHtml(__('Cancel')) ?>
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
